{
  "manifest_version": 3,
  "name": "CCTV GeoPlanner - 3D Camera Coverage for Google Earth Web",
  "version": "1.0.0",
  "description": "Professional 3D geospatial CCTV camera placement, FOV frustum, blind spot, and DORI coverage planning overlay for Google Earth Web.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://earth.google.com/*",
    "https://server.arcgisonline.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://earth.google.com/web*",
        "*://earth.google.com/web/*"
      ],
      "js": [
        "content/page-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://earth.google.com/web*",
        "*://earth.google.com/web/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CCTV GeoPlanner"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "content/*",
        "popup/assets/*"
      ],
      "matches": [
        "*://earth.google.com/*"
      ]
    }
  ]
}
